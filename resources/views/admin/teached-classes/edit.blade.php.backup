<script>
document.addEventListener('DOMContentLoaded', function() {
    // No longer need to populate departments from teacher selection
    // Departments are now pre-populated based on class major
    
    // Keep this for backward compatibility if needed
    function initDepartmentHandlers(containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;

        function updateRemoveButtons() {
            const groups = container.querySelectorAll('.department-input-group');
            groups.forEach(group => {
                const removeBtn = group.querySelector('.remove-dept-btn');
                if (removeBtn) {
                    removeBtn.style.display = groups.length > 1 ? 'block' : 'none';
                }
            });
        }

        // Add department button
        const addBtn = container.nextElementSibling;
        if (addBtn && addBtn.id === 'add-department') {
            addBtn.addEventListener('click', function() {
                const newGroup = document.createElement('div');
                newGroup.className = 'department-input-group mb-2';
                newGroup.innerHTML = `
                    <div class="input-group">
                        <input type="text" name="departments[]" class="form-control" placeholder="Contoh: Bahasa Indonesia">
                        <button type="button" class="btn btn-outline-danger remove-dept-btn">Hapus</button>
                    </div>
                `;
                container.appendChild(newGroup);
                updateRemoveButtons();

                newGroup.querySelector('.remove-dept-btn').addEventListener('click', function() {
                    newGroup.remove();
                    updateRemoveButtons();
                });
            });
        }

        // Remove department buttons
        container.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-dept-btn')) {
                e.preventDefault();
                e.target.closest('.department-input-group').remove();
                updateRemoveButtons();
            }
        });

        updateRemoveButtons();
    }

    // Initialize for main form (if needed)
    initDepartmentHandlers('departments-container');

    // Dynamic subject loading based on teacher selection
    const teacherSelect = document.getElementById('teacher_id');
    const subjectSelect = document.getElementById('subject_ids_select');
    const submitBtn = document.getElementById('submitBtn');
    const conflictAlert = document.getElementById('conflictAlert');
    const conflictMessage = document.getElementById('conflictMessage');
    const teacherSubjectsDisplay = document.getElementById('teacherSubjectsDisplay');
    const teacherSubjectsText = document.getElementById('teacherSubjectsText');
    const classId = '{{ $class->id }}';

    teacherSelect.addEventListener('change', async function() {
        const teacherId = this.value;
        const selectedOption = this.options[this.selectedIndex];
        const teacherSubjects = selectedOption.dataset.subjects || '';
        
        if (!teacherId) {
            subjectSelect.innerHTML = '<option disabled>-- Pilih guru terlebih dahulu --</option>';
            subjectSelect.disabled = true;
            submitBtn.disabled = true;
            conflictAlert.classList.add('d-none');
            teacherSubjectsDisplay.classList.add('d-none');
            return;
        }

        // Display teacher's subjects
        if (teacherSubjects) {
            teacherSubjectsText.textContent = teacherSubjects;
            teacherSubjectsDisplay.classList.remove('d-none');
        } else {
            teacherSubjectsDisplay.classList.add('d-none');
        }

        try {
            const response = await fetch(`/admin/teached-classes/${classId}/subjects?teacher_id=${teacherId}`);
            const data = await response.json();

            if (data.error) {
                subjectSelect.innerHTML = '<option disabled>Error: ' + data.error + '</option>';
                subjectSelect.disabled = true;
                submitBtn.disabled = true;
                return;
            }

            // Build subject options
            let html = '';
            const conflictSubjects = [];

            data.subjects.forEach(subject => {
                const disabled = subject.is_assigned ? 'disabled' : '';
                const label = subject.name + (subject.is_assigned ? ' (sudah terdaftar)' : ' ()');
                html += `<option value="${subject.id}" ${disabled}>${label}</option>`;
                
                if (subject.is_assigned) {
                    conflictSubjects.push(subject.name);
                }
            });

            subjectSelect.innerHTML = html;
            subjectSelect.disabled = false;

            // Show conflict alert if any
            if (conflictSubjects.length > 0) {
                conflictAlert.classList.remove('d-none');
                conflictMessage.textContent = `Guru ini memiliki mata pelajaran "${conflictSubjects.join(', ')}" yang sudah diajarkan di kelas ini oleh guru lain.`;
                submitBtn.disabled = true;
            } else {
                conflictAlert.classList.add('d-none');
                submitBtn.disabled = false;
            }
        } catch (error) {
            console.error('Error:', error);
            subjectSelect.innerHTML = '<option disabled>Error loading subjects</option>';
            subjectSelect.disabled = true;
            submitBtn.disabled = true;
        }
    });

    // Enable/disable submit when subjects are selected
    subjectSelect.addEventListener('change', function() {
        const hasConflict = conflictAlert.classList.contains('d-none') === false;
        submitBtn.disabled = hasConflict || this.selectedOptions.length === 0;
    });

    // If teacher is pre-selected (from validation error), trigger change event
    if (teacherSelect.value) {
        teacherSelect.dispatchEvent(new Event('change'));
    }
</script>
<script src="{{ asset('js/action-dropdown.js') }}"></script>

                    </div>
                </div>
@endsection
